        "\n",
        "# ==========================================\n",
        "# 核心修改：基于您的 CIF 文件构建模型\n",
        "# ==========================================\n",
        "\n",
        "def get_slabs_from_cif(filename):\n",
        "    \"\"\"\n",
        "    读取CIF，切出(111)面，并生成 S-基底 和 O-基底\n",
        "    \"\"\"\n",
        "    if not os.path.exists(filename):\n",
        "        raise FileNotFoundError(f\"错误：找不到文件 {filename}。请确保您已将其上传到 Colab 左侧文件栏！\")\n",
        "\n",
        "    print(f\"正在读取结构文件: {filename} ...\")\n",
        "    # 1. 读取体相结构\n",
        "    bulk = Structure.from_file(filename)\n",
        "\n",
        "    # 2. 切面 (111面是尖晶石/FCC类最常见的稳定面)\n",
        "    # min_slab_size=9埃 (约2-3层原子), vacuum=15埃 (真空层)\n",
        "    slab_gen = SlabGenerator(bulk, miller_index=(1, 1, 1), min_slab_size=9, min_vacuum_size=15, center_slab=True)\n",
        "    all_slabs = slab_gen.get_slabs()\n",
        "\n",
        "    # 选择一个非极性或化学计量比合理的切面 (通常取第一个即可)\n",
        "    target_slab_structure = all_slabs[0]\n",
        "    print(f\"切面完成。切面公式: {target_slab_structure.formula}\")\n",
        "\n",
        "    # 3. 转换 S-样品 (主角) 为 ASE 格式\n",
        "    s_slab_ase = AseAtomsAdaptor.get_atoms(target_slab_structure)\n",
        "\n",
        "    # 4. 制作 O-样品 (配角) - 将所有 S 替换为 O\n",
        "    o_slab_structure = target_slab_structure.copy()\n",
        "    o_slab_structure.replace_species({\"S\": \"O\"})\n",
        "    o_slab_ase = AseAtomsAdaptor.get_atoms(o_slab_structure)\n",
        "\n",
        "    return s_slab_ase, o_slab_ase\n",
        "\n",
        "def get_molecule(mol_name):\n",
        "    \"\"\"构建多硫化物分子 (简单模型)\"\"\"\n",
        "    # 这里定义简单的初始构型，CHGNet会自动优化它们\n",
        "    if mol_name == 'Li2S':\n",
        "        return Atoms('Li2S', positions=[(0, 0, 0), (2.1, 0, 0), (1.05, 1.8, 0)])\n",
        "    elif mol_name == 'Li2S2':\n",
        "        return Atoms('Li2S2', positions=[(0,0,0), (2.1,0,0), (0,2.1,0), (2.1,2.1,0)])\n",
        "    elif mol_name == 'Li2S4':\n",
        "        return Atoms('Li2S4', positions=[(0,0,0), (2,0,0), (4,0,0), (6,0,0), (1,1,0), (5,1,0)])\n",
        "    elif mol_name == 'Li2S6':\n",
        "        # 环状/链状混合示意\n",
        "        return Atoms('Li2S6', positions=[(0,0,0), (2,0,0), (4,0,0), (5,1,0), (4,2,0), (2,2,0), (0,2,0), (1,-1,0)])\n",
        "    elif mol_name == 'Li2S8':\n",
        "        # 长链示意\n",
        "        return Atoms('Li2S8', positions=[(i*1.8, 0, 0) for i in range(8)] + [(0,2,0), (12,2,0)])\n",
        "    return Atoms('Li2S', positions=[(0, 0, 0), (2.4, 0, 0), (1.2, 2.0, 0)])\n",
        "\n",
        "# ==========================================\n",
        "# 主计算程序\n",
        "# ==========================================\n",
        "\n",
        "# 1. 准备模型\n",
        "cif_filename = 'FeCoNiCuMoS.cif' # 您的文件名\n",
        "\n",
        "try:\n",
        "    s_slab_ref, o_slab_ref = get_slabs_from_cif(cif_filename)\n",
        "except Exception as e:\n",
        "    print(e)\n",
        "    # 中止运行，防止后续报错\n",
        "    raise RuntimeError(\"请先上传文件！\")\n",
        "\n",
        "# 2. 初始化计算器\n",
        "print(\"正在加载 CHGNet (首次运行需下载)...\")\n",
        "calc = CHGNetCalculator(use_device='cpu') # 有GPU可改为 'cuda'\n",
        "\n",
        "molecules = ['Li2S', 'Li2S4', 'Li2S6', 'Li2S8'] # 您可以在这里增减分子\n",
        "results = []\n",
        "\n",
        "print(\"-\" * 60)\n",
        "print(f\"{'分子':<8} | {'表面(基底)':<12} | {'状态':<20}\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "# 3. 预计算分子能量 (E_mol)\n",
        "e_mols = {}\n",
        "for mol_name in molecules:\n",
        "    mol = get_molecule(mol_name)\n",
        "    mol.calc = calc\n",
        "    dyn = BFGS(mol, logfile=None)\n",
        "    dyn.run(fmax=0.05)\n",
        "    e_mols[mol_name] = mol.get_potential_energy()\n",
        "\n",
        "# 4. 循环计算 S样 和 O样\n",
        "slab_dict = {'FeCoNiCuMo-S': s_slab_ref, 'FeCoNiCuMo-O': o_slab_ref}\n",
        "\n",
        "for label, slab_template in slab_dict.items():\n",
        "    # --- 优化洁净表面 ---\n",
        "    slab = slab_template.copy()\n",
        "    # 固定底部一半原子\n",
        "    z_pos = slab.positions[:, 2]\n",
        "    constraint = FixAtoms(indices=[i for i, z in enumerate(z_pos) if z < np.mean(z_pos)])\n",
        "    slab.set_constraint(constraint)\n",
        "\n",
        "    slab.calc = calc\n",
        "    dyn = BFGS(slab, logfile=None)\n",
        "    dyn.run(fmax=0.05)\n",
        "    e_slab = slab.get_potential_energy()\n",
        "\n",
        "    # --- 放置分子并计算 ---\n",
        "    for mol_name in molecules:\n",
        "        print(f\"{mol_name:<8} | {label:<12} | 正在优化结构...\", end=\"\\r\")\n",
        "\n",
        "        system = slab.copy()\n",
        "        mol = get_molecule(mol_name)\n",
        "\n",
        "        # 放置分子：高度设为 2.5 埃，位置稍微随机一点避免重叠\n",
        "        add_adsorbate(system, mol, height=2.5, position='fcc', offset=(1,1))\n",
        "\n",
        "        system.calc = calc\n",
        "        dyn = BFGS(system, logfile=None)\n",
        "        try:\n",
        "            dyn.run(fmax=0.1) # 稍微放宽收敛标准以加快速度\n",
        "            e_total = system.get_potential_energy()\n",
        "\n",
        "            # 计算 E_ads\n",
        "            e_ads = e_total - (e_slab + e_mols[mol_name])\n",
        "\n",
        "            results.append({\n",
        "                '分子': mol_name,\n",
        "                '表面': label,\n",
        "                '吸附能': e_ads\n",
        "            })\n",
        "            print(f\"{mol_name:<8} | {label:<12} | 完成 (Eads={e_ads:.2f} eV)  \")\n",
        "        except:\n",
        "            print(f\"{mol_name:<8} | {label:<12} | 计算失败 (结构可能解离)\")\n",
        "\n",
        "# ==========================================\n",
        "# 结果可视化\n",
        "# ==========================================\n",
        "if results:\n",
        "    df = pd.DataFrame(results)\n",
        "    print(\"\\n\" + \"=\"*40)\n",
        "    print(\" 计算结果汇总 \")\n",
        "    print(\"=\"*40)\n",
        "    print(df)\n",
        "\n",
        "    # 绘图\n",
        "    plt.figure(figsize=(10, 6))\n",
        "    pivot_df = df.pivot(index='分子', columns='表面', values='吸附能')\n",
        "\n",
        "    # 设定颜色：红色系为主(S)，蓝色系为辅(O)\n",
        "    pivot_df.plot(kind='bar', color=['#1f77b4', '#d62728'], alpha=0.85, ax=plt.gca())\n",
        "\n",
        "    plt.title('FeCoNiCuMo 高熵合金：硫化物 vs 氧化物 吸附能对比', fontproperties=my_font, fontsize=15)\n",
        "    plt.ylabel('吸附能 (eV)', fontproperties=my_font, fontsize=12)\n",
        "    plt.xlabel('多硫化物分子', fontproperties=my_font, fontsize=12)\n",
        "    plt.axhline(0, color='black', linewidth=0.8, linestyle='--')\n",
        "    plt.legend(prop=my_font)\n",
        "    plt.xticks(rotation=0)\n",
        "    plt.grid(axis='y', linestyle='--', alpha=0.3)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "else:\n",
        "    print(\"没有得到有效结果，请检查报错信息。\")"
      ]
    },
