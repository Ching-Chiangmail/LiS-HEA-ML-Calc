        "# @title 全自动计算流程 (读取您的CIF文件版)\n",
        "# 1. 安装环境\n",
        "!pip install chgnet pymatgen ase pandas matplotlib > /dev/null\n",
        "!wget https://github.com/StellarCN/scp_zh/raw/master/fonts/SimHei.ttf -O SimHei.ttf > /dev/null\n",
        "\n",
        "import os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.font_manager as fm\n",
